{
  "name": "cs",
  "description": "Coptic Standard Project layout (CS fonts, 2002).",
  "fonts": ["CS Avva Shenouda", "CS Coptic Manuscript", "CS Copto Manuscript"],
  "passthrough": " 0123456789!#$%()*+-./?",
  "chars": {
    "a": "ⲁ", "b": "ⲃ", "c": "ⲥ", "d": "ⲇ", "e": "ⲉ", "f": "ϥ", "g": "ⲅ",
    "h": "ϩ", "i": "ⲓ", "j": "ϫ", "k": "ⲕ", "l": "ⲗ", "m": "ⲙ", "n": "ⲛ",
    "o": "ⲟ", "p": "ⲡ", "q": "ϧ", "r": "ⲣ", "s": "ϣ", "t": "ⲧ", "u": "ⲩ",
    "v": "ⲫ", "w": "ⲱ", "x": "ⲝ", "y": "ⲏ", "z": "ⲍ",
    ";": "ⲑ", ",": "ⲭ", "'": "ⲯ", "[": "ϭ", "]": "ϯ",

    "A": "Ⲁ", "B": "Ⲃ", "C": "Ⲥ", "D": "Ⲇ", "E": "Ⲉ", "F": "Ϥ", "G": "Ⲅ",
    "H": "Ϩ", "I": "Ⲓ", "J": "Ϫ", "K": "Ⲕ", "L": "Ⲗ", "M": "Ⲙ", "N": "Ⲛ",
    "O": "Ⲟ", "P": "Ⲡ", "Q": "Ϧ", "R": "Ⲣ", "S": "Ϣ", "T": "Ⲧ", "U": "Ⲩ",
    "V": "Ⲫ", "W": "Ⲱ", "X": "Ⲝ", "Y": "Ⲏ", "Z": "Ⲍ",
    ":": "Ⲑ", "<": "Ⲭ", "\"": "Ⲯ", "{": "Ϭ", "}": "Ϯ",

    "|": "ϩ",
    "\\": "ⲟⲩ",
    "^": "ⲋ̅",
    "¡": "ⲟ̅ⲥ̅",
    "&": ";",
    ">": ",",
    "@": ":",
    "_": "=",
    "·": "·"
  },
  "prefix_marks": {
    "`": "̀",
    "=": "̅",
    "~": "̣",
    "Ç": "̈",
    "È": "́",
    "É": "̇",
    "Ê": "̗",
    "Ë": "̿",
    "Í": "̳"
  },
  "postfix_marks": {},
  "unknown": {
    "Ì": "triple overline; no single Unicode equivalent"
  }
